@startuml
title Serverless Computer Vision Pipeline - Architektur

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

actor "Client" as client

cloud "AWS" {
  component "Privater S3-Bucket\nBild-Uploads" as s3
  component "AWS Lambda\nPython 3.12 + Pillow" as lambda
  database "DynamoDB\nBildmetadaten" as dynamodb
  queue "SQS\nDead-Letter Queue" as dlq
  component "CloudWatch\nLogs" as cloudwatch
}

client --> s3 : Upload\nJPEG / JPG / PNG
s3 --> lambda : ObjectCreated-Event
lambda --> s3 : Bildobjekt lesen
lambda --> dynamodb : Analyseergebnis speichern
lambda --> cloudwatch : Ausführungslogs
lambda --> dlq : Fehlgeschlagene\nasynchrone Aufrufe

note right of lambda
Bildqualität lokal analysieren:
Format, Größe, Helligkeit,
Kontrast und Schärfe
end note

note bottom of s3
Privat, serverseitig verschlüsselt,
Lifecycle-Löschung nach 7 Tagen
end note

@enduml
